# =============================================================================
# Restaurant Ordering & Delivery Management System — Environment Configuration
# Copy this file to .env and fill in your local values. Never commit .env!
# =============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database (PostgreSQL 16 recommended; leave blank in dev to use SQLite fallback)
# Example: postgres://postgres:postgres@localhost:5432/restaurant
DATABASE_URL=

# Redis, Celery & Channels (Redis is required in development and production)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
USE_IN_MEMORY_CHANNEL_LAYER=False

# Localization Defaults (Confirmed: Ghana & GHS)
DEFAULT_COUNTRY=Ghana
DEFAULT_CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# Restaurant Origin Coordinates (Accra, Ghana default)
RESTAURANT_NAME=Cho Restaurant
RESTAURANT_LATITUDE=5.603717
RESTAURANT_LONGITUDE=-0.186964

# Delivery Fee Engine Defaults (GHS)
DELIVERY_FEE_MODE=DISTANCE
FLAT_DELIVERY_FEE=15.00
BASE_DELIVERY_FEE=10.00
BASE_DISTANCE_KM=3.0
PER_KM_FEE=3.00
MAX_DELIVERY_RADIUS_KM=15.0
FREE_DELIVERY_THRESHOLD=200.00

# Live Tracking & Notifications (Developer 4)
GPS_MIN_INTERVAL_SECONDS=2
LOCATION_HISTORY_RETENTION_MINUTES=60
RIDER_LOCATION_STALE_MINUTES=15
NOTIFICATION_SMS_GATEWAY_URL=

# Paystack Integration (Developer 3)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudinary Media Storage (Production / Optional in Dev)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@chorestaurant.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
